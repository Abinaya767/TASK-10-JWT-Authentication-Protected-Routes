            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/courses/{{courseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "courses",
            "{{courseId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"duration\": \"10 weeks\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Patch course",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/courses/{{courseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",

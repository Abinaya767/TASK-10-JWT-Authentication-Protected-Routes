            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/courses/{{courseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",

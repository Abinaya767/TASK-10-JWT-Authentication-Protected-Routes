            "courses",
            "{{courseId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instructor\": \"Dr. Priya\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete course",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/courses/{{courseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "courses",
            "{{courseId}}"
          ]
        }
      }
    }
  ]
}

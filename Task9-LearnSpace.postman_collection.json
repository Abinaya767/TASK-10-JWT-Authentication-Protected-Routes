          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Introduction to Artificial Intelligence\",\n  \"description\": \"Learn AI fundamentals and applications\",\n  \"instructor\": \"Dr. Kumar\",\n  \"duration\": \"8 weeks\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update course",
      "request": {
        "method": "PUT",
        "header": [
          {
